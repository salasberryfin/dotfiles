general {
        output_format = "i3bar"
        colors = true
        color_good =     '#a7c080'  
        color_degraded = '#dbbc7f'  
        color_bad =      '#e67e80'
        color_separator = "#475258"
        interval = 5
}

order += "disk /"
order += "wireless wlp1s0"
order += "ethernet enx803f5d048da5"
order += "battery 0"
order += "memory"
order += "tztime pst"
order += "tztime local"
order += "volume master"

volume master {
        format = "♪ %volume"
        format_muted = "♪ muted (%volume)"
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

wireless wlp1s0 {
        format_up = "wlp1s0%quality, %ip"
        format_down = "wlp1s0 down"
}

ethernet enx803f5d048da5 {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

battery 0 {
        format = "%status %percentage - %emptytime"
        format_down = "No battery"
        status_chr = "⚡ CHR"
        status_bat = "🔋 BAT"
        status_unk = "? UNK"
        status_full = "☻ FULL"
        path = "/sys/class/power_supply/BAT%d/uevent"
        low_threshold = 10
}

tztime local {
        format = "Local: %Y-%m-%d %H:%M:%S"
}

tztime pst {
        format = "PT: %H:%M:%S"
        timezone = "America/Los_Angeles"
        hide_if_equals_localtime = true
}

memory {
        format = "%used"
        threshold_degraded = "10%"
        format_degraded = "MEMORY: %free"
}

disk "/" {
        format = "%free"
}

read_file uptime {
        path = "/proc/uptime"
}
