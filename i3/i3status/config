# i3status: minimal but informative, everforest colors
# icons come from "Symbols Nerd Font" (Material Design set)
general {
        output_format = "i3bar"
        colors = true
        color_good =     "#a7c080"
        color_degraded = "#dbbc7f"
        color_bad =      "#e67e80"
        # no "|" separators: blocks are spaced by i3bar instead
        separator = ""
        interval = 5
}

order += "wireless wlp1s0"
order += "ethernet enx803f5d048da5"
order += "battery 0"
order += "memory"
order += "disk /"
order += "volume master"
order += "tztime local"

# network name only; red icon when disconnected
wireless wlp1s0 {
        format_up = " 󰖩 %essid "
        format_down = " 󰖪 "
}

# usb ethernet adapter: hidden while unplugged
ethernet enx803f5d048da5 {
        format_up = " 󰈀 %ip "
        format_down = ""
}

# whole percentage; time left only while it is meaningful; red below 10%
battery 0 {
        format = " %status %percentage %remaining "
        format_down = ""
        format_percentage = "%.00f%s"
        hide_seconds = true
        last_full_capacity = true
        status_bat = "󰁹"
        status_chr = "󰂄"
        status_full = "󰁹"
        status_idle = "󰁹"
        status_unk = "󰂑"
        path = "/sys/class/power_supply/BAT%d/uevent"
        threshold_type = "percentage"
        low_threshold = 10
}

# used memory as a percentage; yellow/red when available memory runs low
memory {
        format = " 󰍛 %percentage_used "
        threshold_degraded = "10%"
        threshold_critical = "5%"
}

# available space on /; red below 10%
disk "/" {
        format = " 󰋊 %avail "
        threshold_type = "percentage_avail"
        low_threshold = 10
}

volume master {
        format = " 󰕾 %volume "
        format_muted = " 󰝟 %volume "
        device = "default"
        mixer = "Master"
        mixer_idx = 0
}

tztime local {
        format = " %a %-d %b %H:%M "
}
