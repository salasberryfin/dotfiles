configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "alacritty";
    font: "Iosevka Term 12";

    // prompts: a single icon per mode
    display-drun: "󰍉";
    display-run: "󰍉";
    display-window: "󰖯";

    // window switcher: workspace and title
    window-format: "{w}   {t}";

    // fuzzy search, ranked like fzf
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    disable-history: false;

    // remap kb-secondary-copy as it is using ctrl+c by default
    kb-secondary-copy: "Control+Shift+c";
    // ctrl+c now closes rofi
    kb-cancel: "Escape,Control+c,Control+g";
}

@theme "~/.config/rofi/everforest.rasi"
